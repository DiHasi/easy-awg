# Control plane host (compose.control.yaml). Copy to .env next to that file.
# This machine holds the fleet identity - keep it OFF your VPN nodes.

# Port the panel listens on.
WEB_PORT=8080

# Public hostname or IP that clients put in their configs as the VPN endpoint.
# Point this at a DNS record you control: failover means repointing it at another node.
AWG_ENDPOINT_HOST=vpn.example.com

# UDP port clients connect to. Must be open on every node's firewall.
AWG_PORT=51820

# Tunnel subnet. Addresses are allocated fleet-wide from here.
AWG_SUBNET=10.8.0.0/24

# Written into client configs.
AWG_CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
AWG_CLIENT_DNS=1.1.1.1, 8.8.8.8

# Creates the first admin account on an empty database, then can be removed.
# Without these the panel starts but every admin request is refused.
AWG_ADMIN_USER=admin
AWG_ADMIN_PASSWORD=change-me-before-first-start

# Optional: let the panel move the failover record itself when you switch nodes.
# The token needs Zone:Read and Zone:DNS:Edit on this zone and nothing more. Without both values the
# panel still switches - it records the active node and shows you the record to set.
#AWG_CLOUDFLARE_API_TOKEN=
#AWG_CLOUDFLARE_ZONE_ID=

# Which record to move. Defaults to AWG_ENDPOINT_HOST above.
#AWG_DNS_RECORD_NAME=

# TTL written with the record. This is the real speed limit on failover: clients follow only
# as fast as resolvers expire the answer they were last handed.
AWG_DNS_TTL=60

# Automatic failover is armed in the panel (Nodes -> Automatic failover) and needs the
# Cloudflare settings above. These decide how reluctant it is.
# How long the active node must be blocked, down or silent before clients are moved.
#AWG_FAILOVER_GRACE_SECONDS=120
# Minimum time after any switch before an automatic one - stops two half-working nodes from
# passing the traffic back and forth.
#AWG_FAILOVER_COOLDOWN_MINUTES=15
# A node with no status report for this long counts as silent.
#AWG_NODE_STALE_SECONDS=90
# How often the panel re-evaluates the fleet.
#AWG_FAILOVER_CHECK_SECONDS=30

# Probes (Nodes -> Probes) are what tell a blocked node from a healthy one: a blocked node
# reports itself up, because from the inside it is. These tune their checks.
#AWG_PROBE_INTERVAL_SECONDS=60
# Results older than this are ignored, so a probe that stops reporting stops voting.
#AWG_PROBE_STALE_SECONDS=300
# WireGuard retries a handshake every five seconds, so the default is three attempts.
#AWG_PROBE_HANDSHAKE_TIMEOUT_SECONDS=15
# What a probe fetches through the tunnel; any answer counts. Leave unset for the defaults
# (http://1.1.1.1/cdn-cgi/trace and http://connectivitycheck.gstatic.com/generate_204).
# "none" leaves the handshake as the whole check - which reads the common block, where the first
# handshake goes through and everything after it is dropped, as a perfectly healthy node.
#AWG_PROBE_CHECK_URLS=
#AWG_PROBE_TRAFFIC_TIMEOUT_SECONDS=8

# Optional: where the panel tells you a node got blocked, went down, or traffic was moved.
#AWG_NOTIFY_WEBHOOK_URL=
#AWG_NOTIFY_TELEGRAM_BOT_TOKEN=
#AWG_NOTIFY_TELEGRAM_CHAT_ID=

# How long a signed bundle stays valid. This is replay protection for one in flight; it is
# deliberately not an expiry on the copy a node cached, which it re-applies for as long as the
# panel is unreachable.
#AWG_BUNDLE_LIFETIME_MINUTES=15

# How many days of per-peer traffic history the panel keeps, which is what the Traffic page
# charts and what per-person statistics are read from. An hourly record of what each person
# moved is a good deal more than the lifetime counter beside it, so this is one number and 0
# switches it off entirely - the live counters come from the nodes and keep working regardless.
#AWG_USAGE_RETENTION_DAYS=90

# Optional: adopt an existing single-server deployment on first start.
# Mount the old state.json into the container and point this at it.
#AWG_IMPORT_LEGACY_STATE=/import/state.json
