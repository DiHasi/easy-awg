# Control plane host (compose.control.yaml). Copy to .env next to that file.
# This machine holds the fleet identity - keep it OFF your VPN nodes.

# Port the panel listens on.
WEB_PORT=8080

# Public hostname or IP that clients put in their configs as the VPN endpoint.
# Point this at a DNS record you control: failover means repointing it at another node.
AWG_ENDPOINT_HOST=vpn.example.com

# UDP port clients connect to. Must be open on every node's firewall.
AWG_PORT=51820

# Tunnel subnet. Addresses are allocated fleet-wide from here.
AWG_SUBNET=10.8.0.0/24

# Written into client configs.
AWG_CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
AWG_CLIENT_DNS=1.1.1.1, 8.8.8.8

# Creates the first admin account on an empty database, then can be removed.
# Without these the panel starts but every admin request is refused.
AWG_ADMIN_USER=admin
AWG_ADMIN_PASSWORD=change-me-before-first-start

# Optional: adopt an existing single-server deployment on first start.
# Mount the old state.json into the container and point this at it.
#AWG_IMPORT_LEGACY_STATE=/import/state.json
