# Probe host (compose.probe.yaml). Copy to .env next to that file.
# A probe belongs where your clients are - ideally inside the network that does the blocking.
# It is a client of the fleet, never a node: it never receives the fleet configuration, and the
# panel refuses a node token here.

# Where the panel lives. HTTPS in production.
AWG_CONTROL_URL=https://panel.example.com

# One-time PROBE token from the panel (Nodes -> Probes -> Add probe). A node token is refused.
# Only needed for the first start; afterwards the probe authenticates with its own key.
AWG_ENROLLMENT_TOKEN=

# The probe needs no tunnel port and no firewall rules: it only makes outbound handshakes, so
# Docker's default bridge is enough. AWG_ROLE=probe is set in compose.probe.yaml itself, because
# running the node image without it would try to enroll this host as a VPN server.
