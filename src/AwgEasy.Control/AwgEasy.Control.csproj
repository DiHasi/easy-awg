<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>AwgEasy.Control</RootNamespace>
        <AssemblyName>awg-control</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!--
            Deliberately not AOT, unlike the node agent. The control plane is deployed once, so
            small binaries and fast startup buy little, while AOT would fight the auth and data
            libraries this side actually needs.
        -->
        <PublishAot>false</PublishAot>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
        <!--
            Microsoft.Data.Sqlite 10.0.7 still pulls the 2.1.11 native bundle, which carries
            GHSA-2m69-gcr7-jv3q. Pinned forward here, and CI fails on any advisory left in the
            graph. Drop this line once Microsoft.Data.Sqlite moves on by itself, rather than
            leaving two places that name a SQLite version.
        -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AwgEasy.Contracts\AwgEasy.Contracts.csproj" />
    </ItemGroup>

</Project>
