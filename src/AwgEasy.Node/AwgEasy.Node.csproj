<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>AwgEasy.Node</RootNamespace>
        <AssemblyName>awg-node</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- The agent ships to every node: keep it small and quick to start. -->
        <PublishAot>true</PublishAot>
        <!-- The AOT invariant is load-bearing, so a regression has to break the
             build rather than reach a node. Listed codes instead of
             TreatWarningsAsErrors: the solution carries known NU1903 advisories,
             and a gate that fails on those is a gate someone switches off. -->
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2055;IL2057;IL2060;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2104;IL3000;IL3002;IL3050</WarningsAsErrors>
        <!-- Overridden per build. The panel reads this to tell which nodes it has
             already walked during a synchronized fleet upgrade. -->
        <Version>0.0.0-dev</Version>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AwgEasy.Contracts\AwgEasy.Contracts.csproj" />
    </ItemGroup>

</Project>
