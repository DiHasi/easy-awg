# VPN node host (compose.node.yaml). Copy to .env next to that file.
# Prefer scripts/install.sh, which the panel hands you with the token already filled in.

# Where the panel lives. HTTPS in production - this carries the fleet identity.
AWG_CONTROL_URL=https://panel.example.com

# One-time token from the panel (Nodes -> Add node). Expires in 30 minutes.
# Only needed for the first start; after enrollment the node authenticates with its own key.
AWG_ENROLLMENT_TOKEN=

# The tunnel port is not set here: the agent takes it from the fleet configuration, and host
# networking means there is no port mapping to fix at container-creation time. Set AWG_PORT on
# the panel instead.

# Leave empty to detect the default-route interface. With host networking the agent sees the
# server's real interfaces, so this is only needed for unusual routing setups.
AWG_EGRESS_INTERFACE=

# How often the agent checks for a new revision.
AWG_POLL_INTERVAL_SECONDS=20

# The agent's own health endpoint. With host networking this binds on the server, so change it
# if something else already has 8081 there.
AWG_HEALTH_URL=http://127.0.0.1:8081

# Interface name. Changing it on a running node brings the old one down and the new one up.
#AWG_INTERFACE=awg0

# The agent asks an outside echo service where it is reachable and reports that to the panel,
# which points the failover DNS record at it. Set this only if discovery cannot work here -
# a static NAT in front of the server, or no route out to those services. An explicit value is
# taken as given: unlike a discovered one it is not checked for being routable.
#AWG_PUBLIC_IP=

# Which echo services to ask. Empty switches discovery off entirely, and the panel then keeps
# whatever address this node last reported.
#AWG_PUBLIC_IP_URLS=
# How often a known address is checked again.
#AWG_PUBLIC_IP_REFRESH_MINUTES=10
